# Base SQLite
DB_PATH=enrichissement.db

# Recherche web : brave | serper
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
SERPER_API_KEY=

# Scraping poli : identifiez-vous et laissez un contact
USER_AGENT=EnrichissementBot/0.1 (+mailto:contact@votre-domaine.fr)
HTTP_TIMEOUT=10
HTTP_MIN_INTERVAL=1.0

# Vérification SMTP (désactivée par défaut : lancez d'abord `enrich check-port25`)
SMTP_ENABLED=false
SMTP_HELO_HOST=mail.votre-domaine.fr
SMTP_MAIL_FROM=verif@votre-domaine.fr
SMTP_TIMEOUT=15
SMTP_PAUSE_MIN=20
SMTP_PAUSE_MAX=40
SMTP_DAILY_CAP=150

# Seuil d'export du mail dirigeant (0-100)
EXPORT_MIN_SCORE=85

# RGPD : durée de conservation des prospects non convertis (années)
RETENTION_YEARS=3
